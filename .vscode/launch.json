{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Impacto Textil: ejecutar aplicación",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Impacto Textil: preparar base y compilar",
      "program": "${workspaceFolder}/src/backend/ImpactoTextil.Api/bin/Debug/net10.0/ImpactoTextil.Api.dll",
      "cwd": "${workspaceFolder}/src/backend/ImpactoTextil.Api",
      "args": [],
      "stopAtEntry": false,
      "console": "internalConsole",
      "launchSettingsProfile": "https",
      "envFile": "${workspaceFolder}/.env.vscode",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7105;http://localhost:5138"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https://\\S+)",
        "uriFormat": "%s/"
      }
    }
  ]
}
