classDiagram
    class SesionController {
        +Iniciar(IniciarSesionDto, CancellationToken) Task~IActionResult~
        +Actual() ActionResult~SesionDto~
        +Cerrar() Task~IActionResult~
    }
    class AccesoService {
        +AutenticarAsync(IniciarSesionDto, CancellationToken) Task~Usuario?~
    }
    class IUsuarioRepository {
        <<interface>>
        +BuscarPorCorreoAsync(string, CancellationToken) Task~Usuario?~
        +BuscarPorIdAsync(int, CancellationToken) Task~Usuario?~
        +IntentarCrearAsync(Usuario, CancellationToken) Task~bool~
    }
    class IProtectorContrasena {
        <<interface>>
        +CrearHash(string) string
        +Verificar(string, string) bool
    }
    class ValidarSesion {
        +ValidatePrincipal(context) Task
    }
    class AlmacenSesiones {
        +StoreAsync(AuthenticationTicket) Task~string~
        +RetrieveAsync(string) Task~AuthenticationTicket?~
        +RenewAsync(string, AuthenticationTicket) Task
        +RemoveAsync(string) Task
    }
    class IniciarSesionDto {
        +string? correo
        +string? contrasena
    }
    class SesionDto {
        +int id
        +string nombre
        +string rol
    }
    SesionController --> AccesoService
    SesionController ..> IniciarSesionDto
    SesionController ..> SesionDto
    AccesoService --> IUsuarioRepository
    AccesoService --> IProtectorContrasena
    ValidarSesion --> IUsuarioRepository
    SesionController ..> ValidarSesion : identidad
    AlmacenSesiones ..> AuthenticationTicket : ticket revocable
